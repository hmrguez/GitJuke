{
  "name": "gitjuke",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prototype": "vite .scratch/gitjuke/prototype --host 127.0.0.1",
    "prototype:build": "vite build .scratch/gitjuke/prototype",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "cargo test -p gitjuke-core",
    "check": "npm run build && cargo clippy --workspace --all-targets -- -D warnings"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
