{
  "name": "gitjuke",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "prototype": "vite .scratch/gitjuke/prototype --host 127.0.0.1",
    "prototype:build": "vite build .scratch/gitjuke/prototype",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "clean": "python3 scripts/clean-builds.py",
    "tauri": "tauri",
    "desktop:build": "bash scripts/build-desktop.sh local",
    "desktop:sign": "bash scripts/build-desktop.sh signed",
    "desktop:release": "bash scripts/build-desktop.sh release",
    "test": "python3 scripts/test-rust.py",
    "test:diff": "bun test",
    "check": "bun run build && cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "python3 scripts/test-rust.py",
    "test:all": "bun test && bun run test:full",
    "test:diff:node": "node --experimental-strip-types --test tests/frontend/diff.test.mjs",
    "test:setup": "bash scripts/setup-nextest.sh",
    "test:affected": "python3 scripts/test-rust.py --since HEAD",
    "test:qualification": "python3 scripts/test-rust.py --suite qualification --no-cache",
    "test:full": "python3 scripts/test-rust.py --suite full --no-cache",
    "test:partition": "python3 scripts/test-rust.py --check-partition",
    "test:runner": "python3 scripts/test-rust.test.py"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "21.0.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "packageManager": "bun@1.4.2"
}
