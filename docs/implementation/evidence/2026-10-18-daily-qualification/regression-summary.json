[
  {
    "name": "frontend",
    "command": "bun test",
    "exit": 0
  },
  {
    "name": "workspace",
    "command": "cargo test --workspace --offline -- --test-threads=1",
    "exit": 101
  },
  {
    "name": "build",
    "command": "bun run build",
    "exit": 0
  },
  {
    "name": "clippy",
    "command": "cargo clippy --workspace --all-targets --offline -- -D warnings",
    "exit": 0
  },
  {
    "name": "format",
    "command": "cargo fmt --all -- --check",
    "exit": 0
  },
  {
    "name": "whitespace",
    "command": "git diff --check",
    "exit": 0
  }
]
