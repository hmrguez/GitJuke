+    let neighbor = r
+        .save_query(None, None, "Neighbor".into(), "repo:a/b".into())
+        .unwrap();
+    read(&r, &neighbor, 1).await;
+    let sql = rusqlite::Connection::open(d.path().join("db")).unwrap();
+    let before: i64 = sql
+        .query_row(
